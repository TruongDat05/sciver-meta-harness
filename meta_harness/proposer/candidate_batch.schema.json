{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_batch.schema.json",
  "title": "Meta-Harness candidate batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iteration",
    "candidates"
  ],
  "properties": {
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "parent_id",
        "search_axis",
        "hypothesis",
        "templates",
        "expected_tradeoff"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "parent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "search_axis": {
          "type": "string",
          "enum": [
            "exploitation",
            "exploration"
          ]
        },
        "hypothesis": {
          "type": "string",
          "minLength": 12
        },
        "templates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direct",
            "analytical",
            "parallel",
            "sequential"
          ],
          "properties": {
            "direct": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "analytical": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "parallel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "sequential": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          }
        },
        "expected_tradeoff": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
